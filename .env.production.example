# Copy this file on the VPS to /opt/portfolio/env/portfolio.production.env and set mode 600.
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
DATABASE_PURPOSE=production
PRODUCTION_DATABASE_NAME=portfolio
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio_app
POSTGRES_PASSWORD=replace-with-a-unique-production-password
SESSION_COOKIE_NAME=maxpar_cms_session
SESSION_TTL_SECONDS=28800
SESSION_TOKEN_SECRET=replace-with-at-least-32-random-random-characters
COOKIE_SECURE=true
LOG_LEVEL=info
CORS_ORIGINS=https://maxpar.ru
CMS_ORIGINS=https://cms.maxpar.ru
CMS_API_BASE_URL=https://api.maxpar.ru
PUBLIC_API_BASE_URL=https://api.maxpar.ru/api/v1
PUBLIC_CMS_LOGIN_URL=https://cms.maxpar.ru/login
ADMIN_LOGIN=@maxpar.fed
ADMIN_DISPLAY_NAME=Maksim
LOGIN_RATE_LIMIT=10
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900
STORAGE_PROVIDER=s3
MEDIA_STORAGE_DRIVER=s3
MEDIA_STORAGE_ROOT=/app/storage/project-media
MEDIA_PROCESSING_TMP_DIR=/tmp/portfolio-media-processing
S3_ENDPOINT=https://replace-with-selectel-s3-endpoint-from-created-storage
S3_REGION=replace-with-selectel-region
S3_BUCKET=replace-with-portfolio-bucket
S3_ACCESS_KEY_ID=replace-with-backend-only-access-key
S3_SECRET_ACCESS_KEY=replace-with-backend-only-secret-key
S3_FORCE_PATH_STYLE=false
S3_KEY_PREFIX=portfolio/media
S3_ACCESS_MODEL=private-proxy
S3_SIGNED_URL_TTL_SECONDS=300
MEDIA_MAX_FILE_BYTES=8388608
MEDIA_MAX_FILES_PER_REQUEST=10
BACKUP_RETENTION_DAYS=
