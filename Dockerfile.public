FROM nginxinc/nginx-unprivileged:1.29-bookworm

USER root

ARG PUBLIC_API_BASE_URL
ARG PUBLIC_CMS_LOGIN_URL
RUN test -n "$PUBLIC_API_BASE_URL" && test -n "$PUBLIC_CMS_LOGIN_URL" && \
  printf 'globalThis.__PORTFOLIO_CONFIG__ = Object.freeze({ apiBaseUrl: "%s", cmsLoginUrl: "%s" });\n' "$PUBLIC_API_BASE_URL" "$PUBLIC_CMS_LOGIN_URL" > /tmp/runtime-config.js

COPY --chown=101:101 index.html script.js i18n.js analytics.js style.css runtime-config.js /usr/share/nginx/html/
COPY --chown=101:101 components /usr/share/nginx/html/components
COPY --chown=101:101 config /usr/share/nginx/html/config
COPY --chown=101:101 data /usr/share/nginx/html/data
COPY --chown=101:101 mappers /usr/share/nginx/html/mappers
COPY --chown=101:101 services /usr/share/nginx/html/services
COPY --chown=101:101 images /usr/share/nginx/html/images
COPY --chown=101:101 --chmod=0644 deploy/nginx/public.conf /etc/nginx/conf.d/default.conf
RUN cp /tmp/runtime-config.js /usr/share/nginx/html/runtime-config.js && \
  chown 101:101 /usr/share/nginx/html/runtime-config.js && \
  find /usr/share/nginx/html -type d -exec chmod 0755 {} + && \
  find /usr/share/nginx/html -type f -exec chmod 0644 {} +

EXPOSE 8080
USER 101
