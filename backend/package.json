{
  "name": "maxpar-portfolio-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/run-isolated-tests.ts",
    "test:e2e:server": "tsx scripts/start-isolated-e2e-server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:production": "tsx scripts/migrate-production.ts",
    "db:seed": "tsx scripts/seed-projects.ts",
    "db:verify": "tsx scripts/verify-seed.ts",
    "db:verify:media-orientation": "tsx scripts/verify-media-orientation.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "media:cleanup": "tsx scripts/cleanup-media.ts",
    "media:s3:verify": "tsx scripts/verify-s3-storage.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^11.1.0",
    "@smithy/node-http-handler": "^4.9.9",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "pg": "^8.22.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2"
  }
}
