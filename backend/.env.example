NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,https://maxpar.ru,https://www.maxpar.ru
CMS_ORIGINS=http://127.0.0.1:5510,http://localhost:5510
DATABASE_URL=postgres://portfolio_app:replace-with-local-password@127.0.0.1:5433/portfolio
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio_app
POSTGRES_PASSWORD=replace-with-local-password
SESSION_COOKIE_NAME=maxpar_cms_session
SESSION_TTL_SECONDS=28800
SESSION_TOKEN_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
LOGIN_RATE_LIMIT=10
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900
ADMIN_LOGIN=@maxpar.fed
ADMIN_PASSWORD=
